{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=finance_tracker;Username=postgres;Password=postgres;Search Path=reports"
  },
  "Jwt": {
    "Issuer": "FinanceTrackerAPI",
    "Audience": "FinanceTrackerClient",
    "Secret": "dev-only-secret-please-change-in-production-min-32-chars",
    "ExpirationHours": 24
  },
  "UsersService": {
    "BaseUrl": "http://localhost:8081"
  },
  "CategoriesService": {
    "BaseUrl": "http://localhost:8082"
  },
  "TransactionsService": {
    "BaseUrl": "http://localhost:8083"
  },
  "ReportStorage": {
    "Path": "/app/reports-data",
    "PublicBaseUrl": "/api/reports/files"
  }
}
